<?xml version="1.0" encoding="utf-8"?>
<!--
  Phase 76.2.2 (2026-05-23) — Android 12+ device-to-device transfer
  + cloud backup rules. Mirrors backup_rules.xml exclusions.

  cloud-backup       triggered by Google account backup
  device-transfer    triggered when user moves to new device
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="untitled_tracking.xml" />
        <exclude domain="sharedpref" path="CapacitorStorage.xml" />
        <exclude domain="database" path="webview.db" />
        <exclude domain="database" path="webviewCookiesChromium.db" />
        <exclude domain="file" path="app_webview/" />
        <exclude domain="file" path="app_textures/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="untitled_tracking.xml" />
        <exclude domain="sharedpref" path="CapacitorStorage.xml" />
        <exclude domain="database" path="webview.db" />
        <exclude domain="database" path="webviewCookiesChromium.db" />
        <exclude domain="file" path="app_webview/" />
        <exclude domain="file" path="app_textures/" />
    </device-transfer>
</data-extraction-rules>
