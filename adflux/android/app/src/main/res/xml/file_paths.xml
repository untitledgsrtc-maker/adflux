<?xml version="1.0" encoding="utf-8"?>
<!--
  Phase 76.2.2 (2026-05-23) — tightened FileProvider exposure.
  Was: path="." on both — exposed entire external + cache dirs.
  Now: only the specific subdirs the app actually writes into
       (PDF downloads, photo cache, share-intent staging area).
-->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Capacitor + html2canvas-generated PDFs land here for the
         WhatsApp-share intent. -->
    <external-path name="external_files" path="Download/" />
    <external-path name="external_pictures" path="Pictures/" />
    <!-- Photo capture cache (city site photos, offer-letter pic). -->
    <cache-path name="cache_files" path="capture/" />
    <cache-path name="cache_images" path="images/" />
    <!-- Phase 102.I (2026-05-29) — quote PDF cache for in-app share
         sheet. PDFs land in cache/pdfs/ via Filesystem.writeFile,
         then Share grants URI permission to the chosen recipient
         (e.g. WhatsApp) so it can attach the file. -->
    <cache-path name="cache_pdfs" path="pdfs/" />
    <!-- Capacitor internal share-intent staging. -->
    <files-path name="capacitor_files" path="capacitor_share/" />
    <!-- Phase 180 — the in-app APK self-update file lands here (app-private
         external files dir via DownloadManager.setDestinationInExternalFilesDir),
         then FileProvider serves it to the package installer. -->
    <external-files-path name="apk_update" path="apk/" />
    <!-- 2026-10-02 — lead "Scan card" camera fix (APK 96019). Capacitor's
         WebView camera capture (<input type="file" capture>) writes its
         temp photo to getExternalFilesDir(DIRECTORY_PICTURES), i.e. the
         APP-PRIVATE .../Android/data/in.untitledad.app/files/Pictures/,
         then asks this FileProvider for a content:// URI for it. The
         "external_pictures" entry above is the SHARED /storage/emulated/0/
         Pictures folder, a different place, so it does not cover this.
         Phase 76.2.2 (92266b7) replaced external-path "." with the narrow
         entries and dropped the only root that covered it; the capture
         then threw "Unable to create temporary media capture file" and
         Capacitor silently fell back to the file picker. Least-privilege
         fix: expose ONLY that one subfolder. Do NOT restore path=".". -->
    <external-files-path name="capacitor_camera" path="Pictures/" />
</paths>