<?xml version="1.0" encoding="utf-8"?>
<!--
  Phase 56h.2 (19 May 2026) — accent color for FCM notification
  small icon. Brand yellow (#FFE600) per UI_DESIGN_SYSTEM tokens.
  AndroidManifest references this via
  com.google.firebase.messaging.default_notification_color.
-->
<resources>
    <color name="notification_color">#FFE600</color>
    <!-- AppTheme palette referenced by styles.xml. Brand tokens
         per src/styles/tokens.css. Without these AAPT2 errors on
         "@color/colorPrimary not found"; relying on appcompat
         inheritance is brittle. Added 2026-05-23 in Phase 76.2.2
         pre-bundle audit. -->
    <color name="colorPrimary">#0F172A</color>
    <color name="colorPrimaryDark">#0A0E1A</color>
    <color name="colorAccent">#FFE600</color>
</resources>
