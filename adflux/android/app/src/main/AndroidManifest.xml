<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- Phase 56h.2 (19 May 2026) — Firebase Cloud Messaging
             defaults. Without these three meta-data tags, FCM falls
             back to the multi-color launcher icon (Samsung/Xiaomi
             silently drop) and the auto-created "Miscellaneous"
             channel (IMPORTANCE_DEFAULT — no heads-up, no sound).
             The matching channel is created in JS in
             src/utils/nativePush.js → createChannel('untitled_default').
             Server-side FCM payload sets
             android.notification.channel_id = 'untitled_default'
             which the OS matches against the JS-created channel. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="untitled_default"
        />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_notification"
        />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_color"
        />

        <!-- Phase 103.D.3 — native foreground location service. Survives
             app-close to keep writing pings (Step 2+). Step 1 is log-only.
             Permissions (FOREGROUND_SERVICE / FOREGROUND_SERVICE_LOCATION /
             ACCESS_*_LOCATION) already declared above. -->
        <service
            android:name=".LocationTrackingService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location" />
    </application>

    <!-- Permissions -->

    <!-- Network -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Phase 180 — in-app APK self-update (installApk) + the battery-
         unrestricted onboarding dialog. REQUEST_INSTALL_PACKAGES lets the
         app launch the package installer for a downloaded APK (sideload —
         the user still confirms each install). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Phase 56 — GPS tracking (foreground + background). Sales reps + TC
         lead use this for daily km calc + meeting verification. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- Phase 56c — Call log reader. Used to auto-fill
         call_logs.duration_seconds after a tel-tap call ends.
         WARNING: Google Play Store flags READ_CALL_LOG heavily;
         distribute APK by sideload (WhatsApp / direct download)
         instead of through the Play Store.
         Phase 76.2.2 (2026-05-23) — READ_PHONE_STATE removed.
         CallLogPlugin only touches CallLog.Calls content URI; it
         never reads phone state. Permission was unused. -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />

    <!-- Phase 56d — Push notifications via FCM.
         Phase 76.2.2 (2026-05-23) — RECEIVE_BOOT_COMPLETED removed.
         No BootReceiver is registered anywhere in the manifest, and
         FCM does not require this permission to receive push after
         reboot. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Phase 56 — File access for offer-letter / quote PDFs the
         rep downloads on device. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />

    <!-- Phase 95.1 (27 May 2026) — package-visibility queries.
         Android 11+ (API 30) introduced strict intent-visibility
         rules: an app cannot resolve an Intent unless it explicitly
         declares which schemes / packages it queries. Without this
         block, App.openUrl({ url: 'tel:...' }) and 'whatsapp://...'
         silently fail on modern Android — no error, no dialer, no
         WhatsApp. Owner reported "till yesterday everything worked,
         now Call+WhatsApp buttons do nothing on APK". Root cause:
         no queries declared in manifest. The intent resolved on
         older devices that didn't enforce visibility, failed silently
         on newer devices.

         REBUILD REQUIRED. Native manifest change → APK rebuild +
         redistribute. JS live-update alone won't fix this. -->
    <queries>
        <!-- Telephone dialer (tel: scheme) -->
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="tel" />
        </intent>
        <!-- WhatsApp deep links -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="whatsapp" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https"
                  android:host="wa.me" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https"
                  android:host="api.whatsapp.com" />
        </intent>
        <!-- Email handler (mailto:). Phase 155 — AppLauncher.openUrl
             fires ACTION_VIEW, not SENDTO, so the VIEW+mailto intent is
             required for the OS to resolve the device email app. Without
             it the Email button silently did nothing on the APK. -->
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="mailto" />
        </intent>
        <!-- SMS (sms: / smsto:). Phase 222 — AppLauncher.openUrl fires
             ACTION_VIEW, so the VIEW+sms intent is required for the OS to
             resolve the device Messages app; mirrors the Phase 155 mailto
             fix. Without it the "Send SMS" button silently does nothing on
             the APK (web/PWA needs no manifest). -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="sms" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="smsto" />
        </intent>
        <!-- Generic HTTPS — for any browser-routed link we open via
             App.openUrl (e.g. Maps links, share URLs). Most apps
             register HTTPS handlers so this catches anything. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <!-- Explicit WhatsApp packages (consumer + business) so the
             OS surfaces them as targets even when scheme intents
             don't cover their custom paths. -->
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
        <!-- Phase 155 — Gmail, so the OS surfaces it as a mailto target. -->
        <package android:name="com.google.android.gm" />
    </queries>
</manifest>
