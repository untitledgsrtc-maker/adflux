{
  "name": "adflux",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-sw-denylist.mjs && vite build",
    "preview": "vite preview",
    "cap:sweep": "find android/app/src/main/res -name '* *.*' -print -delete || true",
    "cap:sync": "vite build && npx cap sync android && npm run cap:sweep",
    "cap:open:android": "npx cap open android",
    "cap:run:android": "npm run build && npx cap sync android && npm run cap:sweep && npx cap run android",
    "cap:build:apk": "npm run cap:sync && find android -path '*/build/*' -name '* *' -delete 2>/dev/null; cd android && ./gradlew clean assembleDebug",
    "release:apk": "bash scripts/release-apk.sh"
  },
  "dependencies": {
    "@capacitor-community/background-geolocation": "^1.2.26",
    "@capacitor/android": "^8.3.4",
    "@capacitor/app": "^8.1.0",
    "@capacitor/app-launcher": "^8.0.1",
    "@capacitor/core": "^8.3.4",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/geolocation": "^8.2.0",
    "@capacitor/local-notifications": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@googlemaps/js-api-loader": "^1.16.10",
    "@react-pdf/renderer": "^3.4.0",
    "@supabase/supabase-js": "^2.39.0",
    "date-fns": "^3.3.1",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.358.0",
    "pdf-lib": "^1.17.1",
    "qrcode.react": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.3",
    "reactflow": "^11.11.4",
    "xlsx": "^0.18.5",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.3.4",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "vite": "^5.1.6",
    "vite-plugin-pwa": "^1.3.0"
  }
}
