{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "remote-site",
  "description": "The Untitled OS website shown inside the main window may use the agent commands",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "https://app.untitledad.in/*"
    ]
  },
  "permissions": [
    "core:default",
    "core:event:default",
    "allow-idle-seconds",
    "allow-active-window",
    "allow-take-screenshot",
    "allow-device-name",
    "allow-show-window",
    "allow-hide-window",
    "allow-set-tray-tooltip",
    "allow-autostart-enabled",
    "allow-set-autostart",
    "allow-bring-to-front"
  ]
}